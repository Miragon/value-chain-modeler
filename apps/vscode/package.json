{
  "name": "value-chain-modeler",
  "private": true,
  "version": "0.4.0",
  "displayName": "Value Chain Modeler",
  "description": "View and edit value chain diagrams (Wertschöpfungskettendiagramme) directly in VS Code as *.vc or *.vc.json files.",
  "publisher": "miragon-gmbh",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/value-chain-modeler.git",
    "directory": "apps/vscode"
  },
  "bugs": "https://github.com/Miragon/value-chain-modeler/issues",
  "homepage": "https://github.com/Miragon/value-chain-modeler/tree/main/apps/vscode#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "value chain",
    "wertschöpfungskette",
    "process landscape",
    "aris",
    "diagram"
  ],
  "main": "./dist/extension.cjs",
  "type": "module",
  "activationEvents": [
    "onCustomEditor:valueChain.diagramEditor"
  ],
  "contributes": {
    "languages": [
      {
        "id": "value-chain",
        "aliases": [
          "Value Chain",
          "value-chain"
        ],
        "extensions": [
          ".vc",
          ".vc.json"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/icons/value-chain-light.svg",
          "dark": "./media/icons/value-chain-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "value-chain",
        "scopeName": "source.value-chain",
        "path": "./syntaxes/value-chain.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "valueChain.diagramEditor",
        "displayName": "Value Chain Diagram",
        "selector": [
          {
            "filenamePattern": "*.vc.json"
          },
          {
            "filenamePattern": "*.vc"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "valueChain.newDiagram",
        "title": "New Empty Value Chain Diagram",
        "category": "Value Chain",
        "shortTitle": "Value Chain Diagram"
      },
      {
        "command": "valueChain.newDiagramFromExample",
        "title": "New Value Chain Diagram from Example",
        "category": "Value Chain"
      }
    ],
    "menus": {
      "file/newFile": [
        {
          "command": "valueChain.newDiagram",
          "group": "valueChain"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "vscode:prepublish": "node esbuild.config.mjs --production",
    "package": "vsce package --no-dependencies -o value-chain-modeler.vsix"
  },
  "dependencies": {
    "@miragon/value-chain-renderer": "0.4.0",
    "@miragon/value-chain-schema-model": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
