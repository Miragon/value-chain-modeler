{
  "name": "value-chain-modeler",
  "private": true,
  "version": "0.6.1",
  "displayName": "Value Chain Modeler",
  "description": "View and edit value chain diagrams (Wertschöpfungskettendiagramme) directly in VS Code as *.vc or *.vc.json files.",
  "publisher": "miragon-gmbh",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/value-chain-modeler.git",
    "directory": "apps/vscode"
  },
  "bugs": "https://github.com/Miragon/value-chain-modeler/issues",
  "homepage": "https://github.com/Miragon/value-chain-modeler/tree/main/apps/vscode#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "value chain",
    "wertschöpfungskette",
    "process landscape",
    "aris",
    "diagram"
  ],
  "main": "./dist/extension.cjs",
  "type": "module",
  "activationEvents": [
    "onCustomEditor:valueChain.diagramEditor"
  ],
  "contributes": {
    "languages": [
      {
        "id": "value-chain",
        "aliases": [
          "Value Chain",
          "value-chain"
        ],
        "extensions": [
          ".vc",
          ".vc.json"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/icons/value-chain-light.svg",
          "dark": "./media/icons/value-chain-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "value-chain",
        "scopeName": "source.value-chain",
        "path": "./syntaxes/value-chain.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "valueChain.diagramEditor",
        "displayName": "Value Chain Diagram",
        "selector": [
          {
            "filenamePattern": "*.vc.json"
          },
          {
            "filenamePattern": "*.vc"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "valueChain.newDiagram",
        "title": "New Empty Value Chain Diagram",
        "category": "Value Chain",
        "shortTitle": "Value Chain Diagram"
      },
      {
        "command": "valueChain.newDiagramFromExample",
        "title": "New Value Chain Diagram from Example",
        "category": "Value Chain"
      },
      {
        "command": "valueChain.openSource",
        "title": "Open Source to the Side",
        "category": "Value Chain",
        "icon": "$(go-to-file)"
      },
      {
        "command": "valueChain.openDiagram",
        "title": "Open Diagram to the Side",
        "category": "Value Chain",
        "icon": "$(open-preview)"
      },
      {
        "command": "valueChain.fitView",
        "title": "Fit to View",
        "category": "Value Chain"
      },
      {
        "command": "valueChain.exportPng",
        "title": "Export as PNG",
        "category": "Value Chain"
      },
      {
        "command": "valueChain.exportSvg",
        "title": "Export as SVG",
        "category": "Value Chain"
      }
    ],
    "menus": {
      "file/newFile": [
        {
          "command": "valueChain.newDiagram",
          "group": "valueChain"
        }
      ],
      "editor/title": [
        {
          "command": "valueChain.openSource",
          "when": "activeCustomEditorId == valueChain.diagramEditor",
          "group": "navigation"
        },
        {
          "command": "valueChain.openDiagram",
          "when": "editorLangId == value-chain",
          "group": "navigation"
        },
        {
          "command": "valueChain.fitView",
          "when": "activeCustomEditorId == valueChain.diagramEditor",
          "group": "valueChain@1"
        },
        {
          "command": "valueChain.exportPng",
          "when": "activeCustomEditorId == valueChain.diagramEditor",
          "group": "valueChain@2"
        },
        {
          "command": "valueChain.exportSvg",
          "when": "activeCustomEditorId == valueChain.diagramEditor",
          "group": "valueChain@3"
        }
      ],
      "commandPalette": [
        {
          "command": "valueChain.openSource",
          "when": "activeCustomEditorId == valueChain.diagramEditor"
        },
        {
          "command": "valueChain.openDiagram",
          "when": "editorLangId == value-chain"
        },
        {
          "command": "valueChain.fitView",
          "when": "activeCustomEditorId == valueChain.diagramEditor"
        },
        {
          "command": "valueChain.exportPng",
          "when": "activeCustomEditorId == valueChain.diagramEditor"
        },
        {
          "command": "valueChain.exportSvg",
          "when": "activeCustomEditorId == valueChain.diagramEditor"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get Started with Value Chains",
        "description": "A value chain diagram shows how a company creates value: steps as chevrons, the order they run in, the sub-steps they break into and the organizational units responsible for them. This extension lets you create and edit value chain diagrams in VS Code as plain *.vc.json files.",
        "steps": [
          {
            "id": "new",
            "title": "Create a diagram",
            "description": "Start from an empty diagram: a plain JSON file that opens as a canvas.\n[Create empty diagram](command:valueChain.newDiagram)",
            "media": {
              "markdown": "media/walkthrough/new.md"
            },
            "completionEvents": [
              "onCommand:valueChain.newDiagram"
            ]
          },
          {
            "id": "example",
            "title": "Open the example",
            "description": "See a finished diagram: Porter's value chain with sub-steps and an organizational unit.\n[Create diagram from example](command:valueChain.newDiagramFromExample)",
            "media": {
              "markdown": "media/walkthrough/example.md"
            },
            "completionEvents": [
              "onCommand:valueChain.newDiagramFromExample"
            ]
          },
          {
            "id": "source",
            "title": "Open the source to the side",
            "description": "The file is the diagram: edit the JSON beside the canvas and watch both stay in sync.\n[Open Source to the Side](command:valueChain.openSource)",
            "media": {
              "markdown": "media/walkthrough/source.md"
            },
            "completionEvents": [
              "onCommand:valueChain.openSource"
            ]
          },
          {
            "id": "learn",
            "title": "Learn the basics",
            "description": "Add steps and organizational units from the palette, connect them, then export the diagram as PNG or SVG.",
            "media": {
              "markdown": "media/walkthrough/learn.md"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "notices": "node scripts/third-party-notices.mjs",
    "vscode:prepublish": "node esbuild.config.mjs --production",
    "package": "vsce package --no-dependencies -o value-chain-modeler.vsix"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@miragon/modeler-shell": "0.3.2",
    "@miragon/value-chain-renderer": "0.6.1",
    "@miragon/value-chain-schema-model": "0.6.1",
    "diagram-js": "15.28.1",
    "didi": "12.0.0",
    "jsonc-parser": "3.3.1",
    "tiny-svg": "4.1.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3"
  }
}
