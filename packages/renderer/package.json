{
  "name": "@miragon/value-chain-renderer",
  "version": "0.1.0",
  "description": "diagram-js based value chain modeler: renderer, viewer, modeler, import/export, CSS.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets/value-chain.css": "./dist/value-chain.css",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "npm --prefix ../.. run test",
    "test:browser": "npm --prefix ../.. run test:browser"
  },
  "dependencies": {
    "@miragon/value-chain-schema-model": "0.1.0",
    "diagram-js": "15.22.0",
    "diagram-js-direct-editing": "3.5.0",
    "didi": "11.0.0",
    "tiny-svg": "4.1.4"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10"
  }
}
