{
  "name": "@miragon/value-chain-renderer",
  "version": "0.5.0",
  "description": "diagram-js based value chain modeler: renderer, viewer, modeler, import/export, CSS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/value-chain-modeler.git",
    "directory": "packages/renderer"
  },
  "homepage": "https://github.com/Miragon/value-chain-modeler/tree/main/packages/renderer#readme",
  "bugs": "https://github.com/Miragon/value-chain-modeler/issues",
  "keywords": [
    "value chain",
    "wertschöpfungskette",
    "aris",
    "vacd",
    "process landscape",
    "diagram-js",
    "modeler",
    "diagram"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets/value-chain.css": "./dist/value-chain.css",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "npm --prefix ../.. run test",
    "test:browser": "npm --prefix ../.. run test:browser"
  },
  "dependencies": {
    "@miragon/modeler-api": "1.1.0",
    "@miragon/value-chain-schema-model": "0.5.0",
    "diagram-js-direct-editing": "3.6.0"
  },
  "peerDependencies": {
    "diagram-js": "^15.28.0",
    "didi": "^11.0.0 || ^12.0.0",
    "tiny-svg": "^4.1.4",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "diagram-js": "15.28.1",
    "didi": "12.0.0",
    "jsdom": "30.1.2",
    "tiny-svg": "4.1.4",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  }
}
