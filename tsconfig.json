{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@miragon/value-chain-schema-model": ["./packages/schema-model/src/index.ts"],
      "@miragon/value-chain-renderer": ["./packages/renderer/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "apps/*/src/**/*.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**", "apps/vscode/**"]
}
